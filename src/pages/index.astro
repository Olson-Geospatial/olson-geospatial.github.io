---
import Base from '../layouts/Base.astro';
---
<Base title="Home">
  <section class="sheet" aria-labelledby="hero-title">
    <span class="coord coord-n" aria-hidden="true">33°52′ N</span>
    <span class="coord coord-w" aria-hidden="true">118°00′ W</span>

    <svg class="sheet-art" viewBox="0 0 300 420" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <g stroke="#9aa7b0" stroke-width="1" fill="none">
        <path d="M0 120 L300 95"/>
        <path d="M0 250 L300 232"/>
        <path d="M70 0 L95 420"/>
        <path d="M205 0 L222 420"/>
      </g>
      <path d="M110 140 L185 128 L198 215 L120 226 Z" fill="#a87b3d" fill-opacity="0.12" stroke="#a87b3d" stroke-width="1.5" stroke-dasharray="6 4"/>
      <path d="M-10 40 C 60 70, 40 160, 120 190 S 230 230, 210 310 S 260 400, 310 420" fill="none" stroke="#1d5f8a" stroke-width="4" stroke-linecap="round" stroke-opacity="0.85"/>
      <circle cx="158" cy="176" r="6" fill="#2f6b4f"/>
      <circle cx="158" cy="176" r="12" fill="none" stroke="#2f6b4f" stroke-width="1.5"/>
    </svg>

    <h1 id="hero-title">Web maps, spatial analysis, and GIS automation</h1>
    <p class="lead">
      I help organizations turn location data into tools their staff and the public can actually use,
      built on open-source software or inside the Esri setup you already have.
    </p>
    <p><a class="button" href="/contact/">Get in touch</a></p>

    <div class="sheet-footer" aria-hidden="true">
      <span>Based in Buena Park, California. Working with clients anywhere.</span>
      <div class="scale-bar">
        <span></span><span></span><span></span><span></span>
        <small><b>0</b><b>1</b><b>2 mi</b></small>
      </div>
    </div>
  </section>

  <h2>Services</h2>
  <ul class="legend">
    <li>
      <svg viewBox="0 0 34 34" aria-hidden="true"><path d="M5 9 L20 4 L29 14 L24 29 L8 26 Z" fill="#1d5f8a" fill-opacity="0.18" stroke="#1d5f8a" stroke-width="2"/></svg>
      <div>
        <h3>WebGIS development</h3>
        <p>Interactive web maps and dashboards that work in any browser, on desktop or phone.</p>
      </div>
    </li>
    <li>
      <svg viewBox="0 0 34 34" aria-hidden="true"><path d="M3 26 C 10 26, 10 10, 17 12 S 25 24, 31 7" fill="none" stroke="#2f6b4f" stroke-width="2.5" stroke-linecap="round"/></svg>
      <div>
        <h3>Spatial analysis</h3>
        <p>Suitability, land cover, and demographic analysis, delivered as clear maps and a plain-language summary.</p>
      </div>
    </li>
    <li>
      <svg viewBox="0 0 34 34" aria-hidden="true"><circle cx="17" cy="17" r="7" fill="#a87b3d"/><circle cx="17" cy="17" r="12" fill="none" stroke="#a87b3d" stroke-width="1.5"/></svg>
      <div>
        <h3>Data cleanup and automation</h3>
        <p>Python workflows that clean, geocode, and update your data so it stays current without manual rework.</p>
      </div>
    </li>
  </ul>

  <h2>Open source or Esri</h2>
  <div class="platforms">
    <div>
      <h3>Starting fresh</h3>
      <p>
        I build on open-source tools like QGIS, PostGIS, MapLibre, and Python. You own everything,
        and there are no software licenses to keep renewing.
      </p>
    </div>
    <div>
      <h3>Already on ArcGIS</h3>
      <p>
        If your organization has ArcGIS Online or ArcGIS Enterprise, I can work directly in your
        organization using ArcGIS Pro, Experience Builder, Field Maps, and ArcPy.
      </p>
    </div>
  </div>
{/*
  <h2>See an example</h2>
  <p>The demo page shows a working map built the way I'd build one for you. <a href="/demo/">View the demo</a></p>
*/}
</Base>
